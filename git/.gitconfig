[user]
	name = Fabio Souza
	email = dev@fabiohcsouza.dev
[init]
	defaultBranch = main
[core]
	editor = helix
	quotepath = false
[fetch]
	prune = true
[diff]
	colorMoved = default
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	lg = log --oneline --graph --decorate
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
