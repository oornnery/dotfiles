#compdef dots
# Tab completion for dots: commands, then the actions of each command.
# A file in fpath because Antigen's stand-in compdef loses the arguments.
if (( CURRENT == 2 )); then
    compadd -- ${(f)"$(dots --commands)"}
elif (( CURRENT == 3 )) && [[ -n $(dots --actions $words[2]) ]]; then
    compadd -- ${(f)"$(dots --actions $words[2])"}
else
    _files
fi
