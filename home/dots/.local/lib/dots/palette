#!/usr/bin/env bash
# dots:summary=Search TUIs, commands, keys, help, man pages and snippets, with a preview
# dots:group=use
# dots:args=[all | tui | dots | keys | help | run | linux | pet]
# dots:actions=tui=Only the TUIs|dots=Only dots commands|keys=Only keyboard shortcuts|help=Only help pages|run=Any command|linux=Man pages|pet=Pet snippets
#
#   dots palette        everything
#   dots palette <mode> only one mode; inside, Tab goes to the next one
#
# fzf, under the prompt in a shell, and the whole floating pane in Zellij (see its
# config.kdl). This script also gives fzf its lines and its preview. A line is
# "<kind> <name> <text>". The preview never runs what it shows: asking any
# command for --help on hover could just as well run it. What you pick runs here;
# a page you read (help, keys, man) gives you back the list when you close it.
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"

SHEETS="${DOTFILES_DIR:-$HOME/dotfiles}/docs/cheatsheets"
LIB="${DOTS_LIB:-$HOME/.local/lib/dots}"

MODES=(all help keys tui dots run linux pet)
WIDTH=${FZF_PREVIEW_COLUMNS:-80}   # fzf tells the preview its width

row() { printf '%s %-16s %s\n' "$1" "$2" "${3:-}"; }  # row <kind> <name> <text>

rows_tui() {
    local name desc
    while read -r name desc; do row tui "$name" "$desc"; done < <(dots tui --list)
}

rows_dots() {
    local line
    while IFS= read -r line; do row dots "${line%%:*}" "${line#*:}"; done < <(dots --describe)
}

rows_keys() {  # the tables of keys of these sheets; the name is the sheet
    local sheet
    for sheet in keys zellij neovim herdr; do
        awk -F'|' -v sheet="$sheet" '/^\| `/ {
            gsub(/`/, "", $2); gsub(/^ +| +$/, "", $2); gsub(/^ +| +$/, "", $3)
            printf "keys %-8s %-20s %s\n", sheet, $2, $3
        }' "$SHEETS/$sheet.md"
    done
}

rows_help() {
    local topic
    while read -r topic; do row help "$topic"; done < <(dots help --list)
}

rows_run() {
    local name
    while read -r name; do row run "$name"; done < <(compgen -c | sort -u)
}

rows_linux() {  # "ls (1) - list files" becomes "linux ls.1 list files"
    man -k . 2>/dev/null | sort -u | awk '{
        name = $1; section = $2; gsub(/[()]/, "", section)
        sub(/^.* \([^)]*\) +- /, "")
        printf "linux %-24s %s\n", name "." section, $0
    }'
}

snippets() {  # "description<tab>command", one per snippet
    pet list | awk '
        /^ *Description:/ { sub(/^ *Description: */, ""); desc = $0 }
        /^ *Command:/     { sub(/^ *Command: */, ""); print desc "\t" $0 }'
}

rows_pet() {
    local n=0 desc _
    while IFS=$'\t' read -r desc _; do printf 'pet %d %s\n' "$((n += 1))" "$desc"; done < <(snippets)
}

rows_all() {
    row mode help 'Help pages'
    row mode keys 'Keyboard shortcuts'
    row mode tui 'TUIs'
    row mode dots 'dots commands'
    row mode run 'Any command'
    row mode linux 'Man pages'
    row mode pet 'Pet snippets'
    rows_tui
    rows_dots
    rows_help
}

markdown() { CLICOLOR_FORCE=1 glow -s "${GLOW_STYLE:-dark}" -w "$WIDTH" "$1"; }

manual() { MANWIDTH=$WIDTH man "$@" 2>/dev/null | col -bx; }  # manual [section] <name>

about() {  # a program, without running it: where it is, then its sheet or man page
    printf '%s\n%s\n\n' "$1" "$(type -P "$1" || echo 'not a file: shell built-in or alias')"
    if [[ -f $SHEETS/$1.md ]]; then markdown "$SHEETS/$1.md"; else manual "$1"; fi
}

preview() {  # preview <kind> <name>
    case $1 in
        tui|run) about "$2" ;;
        keys)    markdown "$SHEETS/$2.md" ;;
        help)
            if [[ -f $SHEETS/$2.md ]]; then markdown "$SHEETS/$2.md"
            else DOTS_COLOR=1 dots help "$2"
            fi ;;
        dots)
            sed -n 's/^# dots:summary=//p' "$LIB/$2"
            sed -n 's/^# dots:args=/\ndots '"$2"' /p' "$LIB/$2"
            sed -n '/^# dots:/d; 2,/^set /{/^#/s/^# \{0,1\}//p}' "$LIB/$2" ;;
        linux)   manual "${2##*.}" "${2%.*}" ;;
        pet)
            snippets | sed -n "$2p" | awk -F'\t' '{ print $1 "\n\n" $2 }' ;;
        mode)    printf 'Open only this mode.\n\ndots palette %s\n' "$2" ;;
    esac
}

act() {  # act <kind> <name> <text>
    case $1 in
        tui|run) exec "$2" ;;
        mode)    exec "$0" "$2" ;;
        help)    dots help "$2" ;;
        keys)    dots help "$2" ;;
        linux)   man "${2##*.}" "${2%.*}" ;;
        pet)     exec pet exec --query "$3" ;;
        dots)
            dots "$2"
            read -rsn1 -p 'Press a key to close' ;;
    esac
}

next() {  # next <prompt> [-1]: the fzf actions that go to the next (or previous) mode
    local i mode=${1%> } step=${2:-1}
    for i in "${!MODES[@]}"; do [[ ${MODES[$i]} == "$mode" ]] && break; done
    mode=${MODES[$(( (i + step + ${#MODES[@]}) % ${#MODES[@]} ))]}
    printf 'change-prompt(%s> )+reload(%q --rows %s)+first' "$mode" "$0" "$mode"
}

pick() {  # pick <mode>: the mode it ended in, then the line picked; nothing when cancelled
    local size=(--height=60% --min-height=20)
    [[ -n ${ZELLIJ:-} ]] && size=()  # the floating pane is already the right size
    "rows_$1" | fzf "${size[@]}" --reverse --border=rounded --ansi \
        --prompt="$1> " --with-nth=2.. --header='Tab next mode · Shift-Tab back' \
        --preview="$(printf '%q' "$0") --preview {1} {2}" --preview-window=right,55%,wrap \
        --bind="tab:transform:$(printf '%q' "$0") --next {fzf:prompt}" \
        --bind="shift-tab:transform:$(printf '%q' "$0") --next {fzf:prompt} -1" \
        --bind="enter:become(printf '%s\\n%s\\n' {fzf:prompt} {})"
}

case "${1:-all}" in
    --rows)    "rows_$2"; exit ;;
    --preview) preview "$2" "$3"; exit 0 ;;  # on failure, fzf would show only stderr
    --next)    next "$2" "${3:-1}"; exit ;;
    all|tui|dots|keys|help|run|linux|pet) need fzf ;;
    *) die "unknown mode: $1" ;;
esac

# A page (help, keys, man) comes back to the list when you close it, in the same
# mode; anything else runs and the palette ends.
mode=${1:-all}
while out=$(pick "$mode") && [[ -n $out ]]; do
    mode=${out%%$'\n'*}; mode=${mode%> }
    read -r kind name text <<< "${out#*$'\n'}"
    case $kind in
        help|keys|linux) act "$kind" "$name" "$text" ;;
        *) act "$kind" "$name" "$text"; exit ;;
    esac
done
