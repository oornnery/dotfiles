#!/usr/bin/env bash
# dots:summary=WSL report (safe to paste) and wslc passthrough
# dots:group=platform
# dots:args=[info | mount [-n] | windows [-n | pull | export | install [-n] [group...] | restore | settings [-n]] | wslc <args...>]
# dots:actions=info=WSL report, safe to paste|mount=Mount the Windows drives plugged in after WSL started|windows=Copy configs to Windows|windows -n=Compare configs with Windows|windows pull=Bring back configs changed on Windows|windows export=Save the winget package list|windows install=Install groups of packages (core, dev, game...)|windows install -n=What each group would install|windows restore=Install every saved winget package|windows settings=Apply the Windows settings|windows settings -n=Test the Windows settings|wslc=Run wslc.exe
#
# `windows` copies the configs in windows/ to the Windows side: pick which ones,
# and whatever it replaces is kept as <file>.bak.<timestamp>. -n only compares.
# `windows pull` is the way back: shows what changed there and brings what you pick.
# `windows export` saves the winget packages in windows/winget/packages.json, and
# `windows restore` installs all of them on a new machine. `windows install` installs
# groups (core, desktop, dev, work, game, ai) from windows/winget/groups instead. `windows settings` applies
# windows/winget/settings.dsc.winget (dark mode, taskbar, developer mode...) with
# winget configure; -n only tests what differs. The repo is public: look at what
# these bring before committing.
#
# `mount` mounts the Windows drives plugged in after WSL started (WSL mounts them
# only when it starts), and unmounts the ones taken out; -n only shows it.
# `dots install automount` does it on its own, as a service.
#
# `info` prints markdown: versions, /etc/wsl.conf, package counts and the
# $HOME layout. Secret files are counted, never named, and Windows user names
# are masked, so the output can go into docs or an issue.
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"

WSLC="${WSLC_EXE:-/mnt/c/Program Files/WSL/wslc.exe}"
mask() { tr -d '\0\r' | sed -E 's#/mnt/c/Users/[^/ ]+#/mnt/c/Users/<user>#g; s#C:\\Users\\[^\\ ]+#C:\\Users\\<user>#g'; }

info() {
    echo "# WSL"; echo
    echo "- distro: $(. /etc/os-release && echo "$PRETTY_NAME"), kernel $(uname -r)"
    echo "- init: $(ps -p 1 -o comm=)"
    if have wsl.exe; then
        wsl.exe --version 2>/dev/null | tr -d '\0\r' | awk -F': ' 'NR<=3 {printf "- %s: %s\n", $1, $2}'
    fi
    [[ -x $WSLC ]] && echo "- wslc: present" || echo "- wslc: not found"

    echo; echo "## /etc/wsl.conf"; echo; echo '```ini'
    cat /etc/wsl.conf 2>/dev/null || echo "(none)"
    echo '```'

    if have dots; then echo; echo "## Packages"; echo; echo '```'; dots pkg 2>/dev/null; echo '```'; fi

    echo; echo "## \$HOME"; echo
    local e n t linked=() local_=() secrets=0 win=0 dirs=0
    local secret_re='^\.(ssh|gnupg|aws|azure|kube|docker|netrc|npmrc|.*history|claude\.json)$'
    shopt -s dotglob nullglob
    for e in "$HOME"/*; do
        n=${e##*/}
        if [[ $n =~ $secret_re ]]; then secrets=$((secrets + 1)); continue; fi
        if [[ -L $e ]]; then
            t=$(readlink "$e")
            case $t in /mnt/*) win=$((win + 1)) ;; *dotfiles/*) linked+=("$n") ;; *) local_+=("$n") ;; esac
        elif [[ $n == .* ]]; then local_+=("$n")
        elif [[ -d $e ]]; then dirs=$((dirs + 1))
        fi
    done
    echo "- linked from dotfiles: ${linked[*]:-none}"
    echo "- only on this machine: ${local_[*]:-none}"
    echo "- links into Windows: $win"
    echo "- secret files (not listed): $secrets"
    echo "- folders (projects etc.): $dirs"
}

win_home() {  # the Windows user folder; override with WIN_HOME
    local d
    if [[ -n ${WIN_HOME:-} ]]; then echo "$WIN_HOME"; return; fi
    for d in /mnt/c/Users/*/; do
        case ${d%/} in */Public|*/Default|*"/Default User"|*"/All Users") continue ;; esac
        [[ -d $d/AppData ]] && { echo "${d%/}"; return; }
    done
    return 1
}

SRC="${DOTFILES_DIR:-$HOME/dotfiles}/windows"

win_rows() {  # fills home and rows, "<file in windows/>|<where it goes>", of the caller
    home=$(win_home) || { err "dots wsl: Windows user folder not found (set WIN_HOME)"; return 1; }
    rows=(
        "glazewm/config.yaml|$home/.glzr/glazewm/config.yaml"
        "yasb/config.yaml|$home/.config/yasb/config.yaml"
        "yasb/styles.css|$home/.config/yasb/styles.css"
        "terminal/settings.json|$home/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
        "Powershell/Microsoft.PowerShell_profile.ps1|$home/Documents/PowerShell/Microsoft.PowerShell_profile.ps1"
        "wsl/.wslconfig|$home/.wslconfig"
    )
}

windows() {  # windows [-n]
    local home src=$SRC row from to state stamp picks=() labels=() rows=()
    win_rows || return 1
    for row in "${rows[@]}"; do
        from=${row%%|*}; to=${row#*|}
        if [[ ! -e $to ]]; then state=new
        elif cmp -s "$src/$from" "$to"; then state=same
        else state=different
        fi
        case $state in
            same) ok "$from: same" ;;
            *)    warn "$from: $state"; labels+=("$from") ;;
        esac
    done
    [[ ${1:-} == -n ]] && return 0
    (( ${#labels[@]} )) || return 0
    if can_prompt; then
        mapfile -t picks < <(printf '%s\n' "${labels[@]}" | choose 'Copy to Windows? (x toggles)')
    else
        err "dots wsl windows: needs a terminal, or use -n to compare"; return 1
    fi
    stamp=$(date +%Y%m%d-%H%M%S)
    for row in "${rows[@]}"; do
        from=${row%%|*}; to=${row#*|}
        [[ " ${picks[*]:-} " == *" $from "* ]] || continue
        mkdir -p "$(dirname "$to")"
        [[ -e $to ]] && cp "$to" "$to.bak.$stamp"
        cp "$src/$from" "$to" && ok "copied $from"
    done
}

pull() {  # bring back what changed on Windows; the repo keeps the old version in git
    local home row from to picks=() labels=() rows=()
    win_rows || return 1
    for row in "${rows[@]}"; do
        from=${row%%|*}; to=${row#*|}
        if [[ ! -e $to ]] || cmp -s "$SRC/$from" "$to"; then continue; fi
        section "$from"
        diff -u --color=always --label repo --label windows "$SRC/$from" "$to"
        labels+=("$from")
    done
    if (( ! ${#labels[@]} )); then ok "nothing changed on Windows"; return 0; fi
    can_prompt || { err "dots wsl windows pull: needs a terminal to pick"; return 1; }
    mapfile -t picks < <(printf '%s\n' "${labels[@]}" | choose 'Bring to the repo? (x toggles)')
    for row in "${rows[@]}"; do
        from=${row%%|*}; to=${row#*|}
        [[ " ${picks[*]:-} " == *" $from "* ]] || continue
        cp "$to" "$SRC/$from" && ok "brought $from"
        # A config can name the user or a home folder, and this repo is public.
        if grep -qF "${home##*/}" "$SRC/$from"; then warn "$from mentions your Windows user: check it before committing"; fi
    done
}

winget() {  # winget.exe, run from a Windows folder, as it needs; the PATH here has no Windows
    local home rows=()
    win_rows || return 1
    (cd /mnt/c && "$home/AppData/Local/Microsoft/WindowsApps/winget.exe" "$@")
}

export_packages() {  # sorted, so that a diff shows only real changes
    local home rows=() tmp saved=$SRC/winget/packages.json
    win_rows || return 1
    need jq
    tmp="$home/AppData/Local/Temp/dots-winget-export.json"
    # Most lines are about what winget cannot export; only its failure matters here.
    winget export -o "$(wslpath -w "$tmp")" --disable-interactivity >/dev/null
    [[ -s $tmp ]] || { err "dots wsl: winget export wrote nothing"; return 1; }
    mkdir -p "${saved%/*}"
    jq '.Sources |= (sort_by(.SourceDetails.Name) | map(.Packages |= sort_by(.PackageIdentifier)))' "$tmp" > "$tmp.sorted"
    # The date always changes, so it alone is not a change.
    if [[ -f $saved ]] && diff -q <(grep -v CreationDate "$saved") <(grep -v CreationDate "$tmp.sorted") >/dev/null; then
        ok "packages: no change"
    else
        cp "$tmp.sorted" "$saved"
        ok "packages: saved $(jq '[.Sources[].Packages[]] | length' "$saved") in windows/winget/packages.json"
    fi
    rm -f "$tmp" "$tmp.sorted"
}

GROUPS_FILE="$SRC/winget/groups"
group_names() { grep -v '^#' "$GROUPS_FILE" | cut -d'|' -f1 | awk 'NF && !seen[$0]++'; }
group_rows()  { awk -F'|' -v g=" $* " '!/^#/ && index(g, " " $1 " ")' "$GROUPS_FILE"; }  # the lines of these groups
saved_ids()   { jq -r '.Sources[].Packages[].PackageIdentifier' "$SRC/winget/packages.json" 2>/dev/null; }

import_json() {  # ids on stdin -> a winget import file: Store ids (9P..., 12 characters) and winget ones
    jq -R -s 'split("\n") | map(select(length > 0)) as $ids | {
        "$schema": "https://aka.ms/winget-packages.schema.2.0.json",
        Sources: [
          { Packages: [$ids[] | select(test("^[0-9A-Z]{12}$") | not) | {PackageIdentifier: .}],
            SourceDetails: { Argument: "https://cdn.winget.microsoft.com/cache", Identifier: "Microsoft.Winget.Source_8wekyb3d8bbwe", Name: "winget", Type: "Microsoft.PreIndexed.Package" } },
          { Packages: [$ids[] | select(test("^[0-9A-Z]{12}$")) | {PackageIdentifier: .}],
            SourceDetails: { Argument: "https://storeedgefd.dsx.mp.microsoft.com/v9.0", Identifier: "StoreEdgeFD", Name: "msstore", Type: "Microsoft.Rest" } }
        ] }'
}

install_groups() {  # install_groups [-n] [group...]: -n lists what is not installed, by group
    local dry=0 g n saved tmp home rows=() groups=()
    [[ ${1:-} == -n ]] && { dry=1; shift; }
    groups=("$@")
    if (( ! ${#groups[@]} )); then
        if (( dry )) || ! can_prompt; then
            mapfile -t groups < <(group_names)
        else
            mapfile -t groups < <(group_names | choose 'Install which groups? (x toggles)') || return 0
        fi
    fi
    (( ${#groups[@]} )) || return 0
    # Not installed, as of the last `dots wsl windows export`.
    saved=" $(saved_ids | tr '\n' ' ') "
    for g in "${groups[@]}"; do
        n=0
        section "$g"
        while IFS='|' read -r _ id name; do
            [[ $saved == *" $id "* ]] && continue
            printf '  %s %s(%s)%s\n' "$name" "$D" "$id" "$N"; n=$(( n + 1 ))
        done < <(group_rows "$g")
        (( n )) || ok "all installed"
    done
    (( dry )) && { note "as of the last export (dots wsl windows export)"; return 0; }
    confirm "Install these groups? What is installed already stays as it is." || return 0
    win_rows || return 1
    tmp="$home/AppData/Local/Temp/dots-winget-groups.json"
    group_rows "${groups[@]}" | cut -d'|' -f2 | import_json > "$tmp"
    winget import -i "$(wslpath -w "$tmp")" --ignore-unavailable --no-upgrade
    rm -f "$tmp"
    export_packages   # the saved list follows what is installed now
}

install_packages() {  # winget asks for what it needs to ask; packages gone from winget are skipped
    local tmp home rows=()
    win_rows || return 1
    tmp="$home/AppData/Local/Temp/dots-winget-import.json"
    cp "$SRC/winget/packages.json" "$tmp" || return 1
    winget import -i "$(wslpath -w "$tmp")" --ignore-unavailable
    rm -f "$tmp"
}

settings() {  # settings [-n]: winget configure, or with -n only its test
    local tmp home rows=() file
    win_rows || return 1
    tmp="$home/AppData/Local/Temp/dots-settings.dsc.winget"
    cp "$SRC/winget/settings.dsc.winget" "$tmp" || return 1
    file=$(wslpath -w "$tmp")
    if [[ ${1:-} == -n ]]; then
        winget configure test -f "$file" --accept-configuration-agreements --disable-interactivity
    else
        winget configure -f "$file" --accept-configuration-agreements
    fi
    local code=$?
    rm -f "$tmp"
    return "$code"
}

case "${1:-info}" in
    info)  # colored in a terminal, plain markdown when piped or redirected
        if [[ -t 1 ]] && have gum; then info | mask | gum format; else info | mask; fi ;;
    windows)
        shift
        case "${1:-}" in
            pull)    pull ;;
            export)  export_packages ;;
            install) shift; install_groups "$@" ;;
            restore) install_packages ;;
            settings) shift; settings "$@" ;;
            *)       windows "$@" ;;
        esac ;;
    mount)  # the same pass the automount service makes, from the repo
        if [[ ${2:-} == -n ]]; then "$DOTFILES/system/wsl-automount/dots-automount" -n
        else dots sudo "$DOTFILES/system/wsl-automount/dots-automount" --once; fi ;;
    wslc)
        shift
        [[ -x $WSLC ]] || { die "wslc.exe not found at $WSLC"; }
        exec "$WSLC" "$@" ;;
    *) die "unknown action: $1" ;;
esac
