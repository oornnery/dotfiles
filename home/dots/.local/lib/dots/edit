#!/usr/bin/env bash
# dots:summary=Pick a file in ~/dotfiles and open it in the editor
# dots:group=config
# dots:args=[search text]
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"

cd "$DOTFILES" || exit 1
pick=$(fd --type f --hidden --exclude .git --exclude packages \
    | fzf --prompt='edit> ' --query="$*" --preview 'dots preview {}') || exit 0
[[ -n $pick ]] && exec "${EDITOR:-helix}" "$pick"
