#!/usr/bin/env bash
# dots:summary=Brightness, night light, zoom, wallpaper and screensaver
# dots:group=desktop
# dots:args=brightness [raise|lower|set <n>|get] | night [on|off] | magnify [in|out|reset|set <n>] | wallpaper [next|prev|random|list|set <path>] | screensaver
# dots:actions=night=Toggle the night light|magnify=Toggle the screen zoom|wallpaper next=Next wallpaper|wallpaper random=Random wallpaper|wallpaper list=List wallpapers|screensaver=Start the screensaver
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"

WALLS="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
WALL_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dots/wallpaper"

brightness() {
    need brightnessctl
    local pct step=${BRIGHTNESS_STEP:-5}
    case ${1:-get} in
        raise) brightnessctl set "$step%+" >/dev/null ;;
        lower) brightnessctl set "$step%-" >/dev/null ;;
        set)   brightnessctl set "${2:?a value from 0 to 100}%" >/dev/null ;;
        get)   brightnessctl -m | cut -d, -f4 | tr -d '%'; return ;;
        *) err "dots display brightness: unknown: $1"; return 1 ;;
    esac
    pct=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
    dots notify Brightness "$pct%" -a brightness -i display-brightness -t 1500 \
        -h string:x-canonical-private-synchronous:brightness -h "int:value:$pct"
}

night() {
    need hyprsunset
    local temp=${NIGHT_MODE_TEMP:-3500} action=${1:-toggle}
    if [[ $action == toggle ]]; then
        if pgrep -x hyprsunset >/dev/null; then action=off; else action=on; fi
    fi
    case $action in
        on)
            pgrep -x hyprsunset >/dev/null || setsid -f hyprsunset -t "$temp" >/dev/null 2>&1
            dots notify "Night light on" "${temp}K" -a night -i weather-clear-night -t 2000 ;;
        off)
            pkill -x hyprsunset
            dots notify "Night light off" -a night -i weather-clear -t 2000 ;;
        status) if pgrep -x hyprsunset >/dev/null; then echo on; else echo off; fi ;;
        *) err "dots display night: unknown: $action"; return 1 ;;
    esac
}

magnify() {
    need hyprctl jq
    local now step=${MAGNIFY_STEP:-0.5} target
    now=$(hyprctl getoption cursor:zoom_factor -j | jq -r .float)
    case ${1:-toggle} in
        in)     target=$(awk -v c="$now" -v s="$step" 'BEGIN{print c+s}') ;;
        out)    target=$(awk -v c="$now" -v s="$step" 'BEGIN{print c-s}') ;;
        reset)  target=1 ;;
        set)    target=${2:?a zoom factor} ;;
        toggle) target=$(awk -v c="$now" 'BEGIN{print (c <= 1.01 ? 1.5 : 1)}') ;;
        *) err "dots display magnify: unknown: $1"; return 1 ;;
    esac
    target=$(awk -v v="$target" 'BEGIN{ if (v < 1) v = 1; if (v > 3) v = 3; printf "%.2f", v }')
    hyprctl keyword cursor:zoom_factor "$target" >/dev/null
    dots notify Magnify "${target}x" -a magnify -i zoom-original -t 1500
}

wallpapers() {
    find "$WALLS" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort
}

wallpaper_apply() {
    local file=$1 monitor
    [[ -f $file ]] || { err "file not found: $file"; return 1; }
    hyprctl hyprpaper preload "$file" >/dev/null
    while IFS= read -r monitor; do
        hyprctl hyprpaper wallpaper "$monitor,$file" >/dev/null
    done < <(hyprctl monitors -j | jq -r '.[].name')
    mkdir -p "$(dirname "$WALL_STATE")"
    echo "$file" > "$WALL_STATE"
    dots notify Wallpaper "${file##*/}" -a wallpaper -i "$file" -t 3000
}

wallpaper() {
    need hyprctl jq
    local action=${1:-next} files i index=0 current=''
    mapfile -t files < <(wallpapers)
    [[ -f $WALL_STATE ]] && current=$(<"$WALL_STATE")
    case $action in
        list) printf '%s\n' "${files[@]}"; return ;;
        get)  echo "$current"; return ;;
        set)  wallpaper_apply "${2:?a file}"; return ;;
    esac
    (( ${#files[@]} )) || { err "no images in $WALLS"; return 1; }
    for i in "${!files[@]}"; do [[ ${files[i]} == "$current" ]] && index=$i; done
    case $action in
        next)   index=$(( (index + 1) % ${#files[@]} )) ;;
        prev)   index=$(( (index - 1 + ${#files[@]}) % ${#files[@]} )) ;;
        random) index=$(( RANDOM % ${#files[@]} )) ;;
        *) err "dots display wallpaper: unknown: $action"; return 1 ;;
    esac
    wallpaper_apply "${files[index]}"
}

screensaver() {
    need tte
    local effects=(beams blackhole bouncyballs bubbles burn crumble decrypt expand fireworks
        middleout overflow pour print rain rings scattered slide spotlights spray swarm
        synthgrid unstable vhstape waves wipe)
    local effect=${effects[RANDOM % ${#effects[@]}]}
    exec "${TERMINAL:-alacritty}" --class screensaver -o window.startup_mode=Fullscreen -o window.opacity=1.0 \
        -e bash -c "date | tte $effect; read -rn 1"
}

case "${1:-}" in
    brightness)  shift; brightness "$@" ;;
    night)       shift; night "$@" ;;
    magnify)     shift; magnify "$@" ;;
    wallpaper)   shift; wallpaper "$@" ;;
    screensaver) screensaver ;;
    *) err "Usage: dots display <brightness|night|magnify|wallpaper|screensaver>"; exit 1 ;;
esac
