#!/usr/bin/env bash
# dots:summary=Web apps as windows (firefoxpwa)
# dots:group=desktop
# dots:args=install <name> <url> [icon] | launch <name> | list | remove [name]
# dots:actions=list=Installed web apps|remove=Remove a web app
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"
need firefoxpwa

id_of() { firefoxpwa profile list 2>/dev/null | awk -v name="$1" '/^- / {id=$2} $0 ~ "Name: " name "$" {print id; exit}'; }
names() { firefoxpwa profile list 2>/dev/null | awk -F'Name: ' '/Name: /{print $2}'; }

case "${1:-list}" in
    install)
        name=${2:-}; url=${3:-}; icon=${4:-}
        [[ -n $name && -n $url ]] || { err "Usage: dots webapp install <name> <url> [icon]"; exit 1; }
        args=(site install "$url" --name "$name")
        [[ -f $icon ]] && args+=(--icon-url "file://$icon")
        firefoxpwa "${args[@]}" && dots notify "Web app installed" "$name" -a webapp ;;
    launch)
        id=$(id_of "${2:-}")
        [[ -n $id ]] || { err "no web app named '${2:-}' (dots webapp list)"; exit 1; }
        exec firefoxpwa site launch "$id" ;;
    list) names ;;
    remove)
        name=${2:-}
        if [[ -z $name ]]; then name=$(names | dots menu 'remove') || exit 0; fi
        [[ -n $name ]] || exit 0
        id=$(id_of "$name")
        [[ -n $id ]] || { err "no web app named '$name'"; exit 1; }
        firefoxpwa site uninstall "$id" && dots notify "Web app removed" "$name" -a webapp ;;
    *) die "unknown action: $1" ;;
esac
