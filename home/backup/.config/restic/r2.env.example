# Copy to ~/.config/restic/r2.env (chmod 600) and fill in. The real file is never tracked.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# The repository password lives in this file; keep a copy in your password manager.
RESTIC_PASSWORD_FILE=/home/<user>/.config/restic/r2.password
