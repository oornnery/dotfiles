#!/usr/bin/env bash
# dots:summary=Run a command in a new Zellij pane, or right here outside Zellij
# dots:args=[--float | --tab] [command...]
#
#   dots pane helix file     a new pane (with no command, a shell)
#   dots pane --float glow   a floating pane
#   dots pane --tab          a new tab with a shell
#
# Helix and yazi call this, so their keys work the same inside and outside Zellij.
# Outside, the command takes over the terminal until it ends.
set -uo pipefail

where=pane
case "${1:-}" in
    --float) where=float; shift ;;
    --tab)   where=tab; shift ;;
    -h|--help) sed -n '5,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
(( $# )) || set -- "${SHELL:-bash}"

# Callers may capture our output (Helix does), so talk to the terminal directly.
[[ -n ${ZELLIJ:-} ]] || exec "$@" </dev/tty >/dev/tty

# Zellij prints the id of the new pane; nobody here wants it.
case $where in
    pane)  zellij run --close-on-exit --cwd "$PWD" -- "$@" ;;
    float) zellij run --floating --close-on-exit --cwd "$PWD" -- "$@" ;;
    tab)   zellij action new-tab --cwd "$PWD" ;;
esac >/dev/null
