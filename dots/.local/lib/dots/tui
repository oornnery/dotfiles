#!/usr/bin/env bash
# dots:summary=Pick a TUI and open it
# dots:args=[--list]
#
# The list is the TUIs table in docs/cheatsheets/packages.md; ones not installed
# are left out.
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_ui"

SHEET="${DOTFILES_DIR:-$HOME/dotfiles}/docs/cheatsheets/packages.md"
[[ -f $SHEET ]] || { err "dots tui: no list at $SHEET"; exit 1; }

rows() {  # "command  what it is for"
    awk -F'|' '
        /^## / { on = ($0 == "## TUIs") }
        on && /^\| `/ {
            match($2, /`[^`]+`/); cmd = substr($2, RSTART + 1, RLENGTH - 2)
            gsub(/^ +| +$/, "", $4); print cmd "\t" $4
        }
    ' "$SHEET" | while IFS=$'\t' read -r cmd what; do
        have "$cmd" && printf '%-12s %s\n' "$cmd" "$what"
    done
}

case "${1:-}" in
    '')
        pick=$(rows | dots menu tui) || exit 0
        [[ -n $pick ]] && exec "${pick%% *}"
        ;;
    --list) rows ;;
    -h|--help) sed -n '2,3p' "$0" ;;
    *) err "dots tui: unknown option: $1"; exit 1 ;;
esac
