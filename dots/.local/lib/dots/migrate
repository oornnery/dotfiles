#!/usr/bin/env bash
# dots:summary=Run one-time changes that a config link cannot carry
# dots:args=[run | list | new <name>]
# dots:actions=run,list,new
#
#   dots migrate             run what is pending on this machine
#   dots migrate list        all of them (✓ done here, • pending)
#   dots migrate new <name>  create one in ~/dotfiles/migrations
#
# Each machine remembers what ran in ~/.local/state/dots/migrations. A failure
# stops there and runs again next time.
# shellcheck disable=SC2154  # colors come from _ui
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_ui"

DIR="${DOTFILES_DIR:-$HOME/dotfiles}/migrations"
DONE="${XDG_STATE_HOME:-$HOME/.local/state}/dots/migrations"

all() { find "$DIR" -maxdepth 1 -name '*.sh' -printf '%f\n' 2>/dev/null | sort; }

pending() {
    local m
    for m in $(all); do [[ -e $DONE/$m ]] || echo "$m"; done
}

mark() { mkdir -p "$DONE"; : > "$DONE/$1"; }

run() {
    local todo m
    todo=$(pending)
    if [[ -z $todo ]]; then note "no pending migrations"; return 0; fi
    warn "$(wc -l <<< "$todo") pending"
    sed 's/^/  /; s/\.sh$//' <<< "$todo"
    if [[ ${1:-} != -y ]]; then
        { : >/dev/tty; } 2>/dev/null || { err "needs a terminal, or use -y"; return 1; }
        confirm 'Run them?' || return 0
    fi
    for m in $todo; do
        section "${m%.sh}"
        if bash "$DIR/$m"; then
            mark "$m"
            ok "done"
        else
            err "$m failed: stopping here, it runs again next time"
            return 1
        fi
    done
}

new() {  # new <name>
    local name=${1:-} slug file
    if [[ -z $name ]] && can_prompt; then name=$(gum input --placeholder 'what it does') || return 0; fi
    [[ -n $name ]] || { err "Usage: dots migrate new <name>"; return 1; }
    slug=$(tr '[:upper:] ' '[:lower:]-' <<< "$name" | tr -cd 'a-z0-9-')
    file="$DIR/$(date +%Y%m%d%H%M%S)-$slug.sh"
    mkdir -p "$DIR"
    printf '#!/usr/bin/env bash\n# %s\nset -euo pipefail\n\n' "$name" > "$file"
    ok "created ${file/#$HOME/\~}"
}

case "${1:-run}" in
    run) shift 2>/dev/null; run "$@" ;;
    -y)  run -y ;;
    list)
        for m in $(all); do
            if [[ -e $DONE/$m ]]; then ok "${m%.sh}"; else warn "${m%.sh}"; fi
        done ;;
    new) shift; new "$@" ;;
    --count) pending | sed '/^$/d' | wc -l ;;
    --init)  # a new machine starts current: older migrations do not apply
        if [[ -d $DONE ]]; then
            run
        else
            mkdir -p "$DONE"
            for m in $(all); do mark "$m"; done
            note "new machine: existing migrations marked as done"
        fi ;;
    -h|--help) sed -n '6,8p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) err "dots migrate: unknown action: $1"; exit 1 ;;
esac
