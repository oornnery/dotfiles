#!/usr/bin/env bash
# dots:summary=Run a command with sudo, password asked through gum
# dots:args=<command> [args...]
set -euo pipefail

(( $# )) || { echo "Usage: dots sudo <command> [args...]" >&2; exit 1; }
export SUDO_ASKPASS="${SUDO_ASKPASS:-${DOTS_LIB:-$HOME/.local/lib/dots}/askpass}"
exec sudo -A "$@"
