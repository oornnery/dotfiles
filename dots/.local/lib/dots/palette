#!/usr/bin/env bash
# dots:summary=Search help, TUIs and dots commands with tv
# dots:args=[tui]
#
#   dots palette      everything
#   dots palette tui  only the TUIs
#
# What you pick runs right here. Zellij opens this in a floating pane (see its
# config.kdl), so there it closes when what you picked ends.
set -uo pipefail

# shellcheck source=/dev/null
. "${DOTS_LIB:-$HOME/.local/lib/dots}/_ui"
need tv

row() { printf '%-6s %-14s %s\n' "$1" "$2" "$3"; }  # row <kind> <name> <description>

rows_tui() {
    local name desc
    while read -r name desc; do row tui "$name" "$desc"; done < <(dots tui --list)
}

rows_dots() {
    local line
    while IFS= read -r line; do row dots "${line%%:*}" "${line#*:}"; done < <(dots --describe)
}

rows_all() {
    row help keys 'All the keys of Zellij and of this palette'
    rows_tui
    rows_dots
    row run command 'Run any command'
}

pick() { tv --no-remote --no-preview --input-header "$1"; }  # the chosen line of stdin

act() {  # act <kind> <name>
    local cmd
    case $1 in
        help) dots help zellij ;;
        tui)  exec "$2" ;;
        run)
            cmd=$(compgen -c | sort -u | pick run)
            [[ -n $cmd ]] && exec "$cmd" ;;
        dots)
            dots "$2"
            read -rsn1 -p 'Press a key to close' ;;
    esac
}

case "${1:-}" in
    '')  choice=$(rows_all | pick palette) ;;
    tui) choice=$(rows_tui | pick tui) ;;
    -h|--help) sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) err "dots palette: unknown action: $1"; exit 1 ;;
esac
[[ -n $choice ]] || exit 0
read -r kind name _ <<< "$choice"
act "$kind" "$name"
