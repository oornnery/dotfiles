#!/usr/bin/env bash
# dots:summary=Switch the color theme: terminal, TUIs, prompt and editors
# dots:group=config
# dots:args=[list | get | set [name] | apply]
# dots:actions=set=Pick a theme, previewing it live|list=Themes and their colors|get=The active theme|apply=Write the active theme again
#
#   dots theme             pick a theme
#   dots theme list        themes with their colors (* = active)
#   dots theme set <name>  switch
#   dots theme apply       write the active theme again
#
# The palette in themes/<name>/alacritty.toml is the only source of colors. New
# shells send it to the terminal, so everything using ANSI colors follows: the
# prompt, fzf, bat, eza, lazygit, lazydocker, btop, yazi, fastfetch. Helix gets
# its matching built-in theme; tmux, vim and the desktop get their theme files
# when they are linked here.
# shellcheck disable=SC2154  # colors come from _ui
set -uo pipefail

# shellcheck source=/dev/null
. "$(dirname "$(realpath "$0")")/_lib"

THEMES="$DOTFILES/themes"
FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dots/theme.sh"
DEFAULT=catppuccin-mocha

names()   { find "$THEMES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; }
current() { if [[ -r $FILE ]]; then sed -n 's/^export DOTS_THEME=//p' "$FILE"; else echo "$DEFAULT"; fi; }

palette() {  # "<key> #rrggbb": bg, fg, cursor and the ANSI colors 0 to 15
    awk '
        /^\[/ { section = $0; next }
        section == "[colors.primary]" && /^background/ { print "bg", hex() }
        section == "[colors.primary]" && /^foreground/ { print "fg", hex() }
        section == "[colors.cursor]"  && /^cursor/     { print "cursor", hex() }
        section == "[colors.normal]" || section == "[colors.bright]" {
            base = section == "[colors.bright]" ? 8 : 0
            if (match($1, /^(black|red|green|yellow|blue|magenta|cyan|white)$/)) print base + index_of($1), hex()
        }
        function hex() { match($0, /#[0-9a-fA-F]{6}/); return substr($0, RSTART, RLENGTH) }
        function index_of(c) {
            return c == "black" ? 0 : c == "red" ? 1 : c == "green" ? 2 : c == "yellow" ? 3 : \
                   c == "blue" ? 4 : c == "magenta" ? 5 : c == "cyan" ? 6 : 7
        }
    ' "$THEMES/$1/alacritty.toml"
}

sequence() {  # the escape codes that set the terminal palette, as printf text
    local key value out=''
    while read -r key value; do
        case $key in
            bg)     out+="\\033]11;$value\\007" ;;
            fg)     out+="\\033]10;$value\\007" ;;
            cursor) out+="\\033]12;$value\\007" ;;
            *)      out+="\\033]4;$key;$value\\007" ;;
        esac
    done < <(palette "$1")
    printf '%s' "$out"
}

terminals() {  # where to send colors. Zellij does not pass them on, so its clients get them directly.
    local pid tty
    if [[ -z ${ZELLIJ:-} ]]; then echo /dev/tty; return; fi
    for pid in $(pgrep -u "$USER" -x zellij); do
        tty=$(readlink "/proc/$pid/fd/0")
        [[ $tty == /dev/pts/* ]] && echo "$tty"
    done
}

send() {  # change the colors of this terminal now, without saving anything
    local seq tty
    [[ -z ${TMUX:-} ]] || return 0
    seq=$(sequence "$1")
    for tty in $(terminals); do
        # shellcheck disable=SC2059  # the format is the palette itself
        { printf "$seq" >"$tty"; } 2>/dev/null
    done
}

sample() {  # the preview pane: ANSI colors, so it changes with the palette
    local i
    for i in 0 1 2 3 4 5 6 7; do printf '\033[4%dm    ' "$i"; done; printf '\033[0m\n'
    for i in 0 1 2 3 4 5 6 7; do printf '\033[10%dm    ' "$i"; done; printf '\033[0m\n\n'
    printf '\033[32moornnery\033[0m \033[36m~/dotfiles\033[0m \033[35mmain\033[0m \033[33m+*?\033[0m \033[36m↑1\033[0m  \033[31m✗1\033[0m  \033[33m12s\033[0m  \033[32mpy:app\033[0m  \033[2m14:32\033[0m\n'
    printf '\033[31m❯\033[0m git status\n\n'
    printf '\033[34mdef\033[0m \033[33mgreet\033[0m(name):\n'
    printf '    \033[35mreturn\033[0m \033[32m"hello "\033[0m + name\n'
}

pick() {  # choose with the terminal showing each theme; Esc goes back
    local now pos choice
    if ! have fzf; then
        names | dots menu theme
        return
    fi
    now=$(current)
    pos=$(names | grep -nx "$now" | cut -d: -f1)
    choice=$(names | fzf --height=40% --reverse --prompt='theme> ' \
        --header='Enter keeps it, Esc goes back' \
        --preview "\"$0\" sample" --preview-window=right,60% \
        --bind "load:pos(${pos:-1})" \
        --bind "focus:execute-silent(\"$0\" preview {})")
    if [[ -z $choice ]]; then send "$now"; return 1; fi
    printf '%s\n' "$choice"
}

zellij_theme() {  # zellij_theme <name>: the same palette, in the format Zellij reads
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/zellij" key value
    local -A color
    [[ -d $dir ]] || return 0
    while read -r key value; do color[$key]=$value; done < <(palette "$1")
    mkdir -p "$dir/themes"
    cat > "$dir/themes/dots.kdl" <<EOF
// Written by dots theme.
themes {
    dots {
        fg "${color[fg]}"
        bg "${color[bg]}"
        black "${color[0]}"
        red "${color[1]}"
        green "${color[2]}"
        yellow "${color[3]}"
        blue "${color[4]}"
        magenta "${color[5]}"
        cyan "${color[6]}"
        white "${color[7]}"
        orange "${color[11]}"
    }
}
EOF
    touch "$dir/config.kdl"  # running sessions reload when it changes
}

put() {  # put <theme file> <destination>: only when that tool is set up here
    [[ -f $THEMES/$1 && -d $(dirname "$2") ]] && cp "$THEMES/$1" "$2"
}

helix_theme() {
    case $1 in
        rose-pine)   echo rose_pine ;;
        tokyo-night) echo tokyonight ;;
        *)           echo "${1//-/_}" ;;
    esac
}

apply() {  # apply <name>
    local name=$1 seq config="$DOTFILES/helix/.config/helix/config.toml"
    [[ -f $THEMES/$name/alacritty.toml ]] || { err "dots theme: no such theme: $name (dots theme list)"; return 1; }
    seq=$(sequence "$name")
    mkdir -p "$(dirname "$FILE")"
    cat > "$FILE" <<EOF
# Written by dots theme. Sourced by every interactive shell.
export DOTS_THEME=$name
case "\${TMUX:-}\${ZELLIJ:-}" in
    '') [ -t 1 ] && [ "\${TERM:-dumb}" != dumb ] && printf '$seq' ;;
esac
EOF
    [[ -f $config ]] && sed -i "s/^theme = .*/theme = \"$(helix_theme "$name")\"/" "$config"
    [[ -e $HOME/.tmux.conf ]] && mkdir -p "$HOME/.config/tmux" && put "$name/tmux.conf" "$HOME/.config/tmux/theme.conf"
    [[ -e $HOME/.vimrc ]] && mkdir -p "$HOME/.vim" && put "$name/vim.vim" "$HOME/.vim/theme.vim"
    put "$name/waybar.css"  "$HOME/.config/waybar/theme.css"
    put "$name/wofi.css"    "$HOME/.config/wofi/theme.css"
    put "$name/mako.config" "$HOME/.config/mako/theme.config"
    put "$name/walker.css"  "$HOME/.config/walker/themes/default/theme.css"
    put "$name/alacritty.toml" "$HOME/.config/alacritty/theme.toml"
    zellij_theme "$name"
    send "$name"
    if have hyprctl && [[ -x ${DOTS_LIB:-}/hypr ]]; then dots hypr reload >/dev/null 2>&1; fi
    ok "theme: $name"
    note "other open terminals change on their next shell; Helix with :config-reload"
}

list() {
    local name now key value line
    now=$(current)
    for name in $(names); do
        line=''
        if [[ -n $N ]]; then
            while read -r key value; do
                [[ $key =~ ^[1-6]$ ]] || continue
                line+=$(printf '\033[48;2;%d;%d;%dm  ' "0x${value:1:2}" "0x${value:3:2}" "0x${value:5:2}")
            done < <(palette "$name")
            line+=$N
        fi
        if [[ $name == "$now" ]]; then
            printf '%s* %-18s%s %s\n' "$G" "$name" "$N" "$line"
        else
            printf '  %-18s %s\n' "$name" "$line"
        fi
    done
}

case "${1:-pick}" in
    pick)
        choice=$(pick) || exit 0
        [[ -n $choice ]] && apply "$choice" ;;
    list) list ;;
    get)  current ;;
    set)
        if [[ -n ${2:-} ]]; then
            apply "$2"
        else
            choice=$(pick) || exit 0
            [[ -n $choice ]] && apply "$choice"
        fi ;;
    apply) apply "$(current)" ;;
    preview) [[ -f $THEMES/${2:-}/alacritty.toml ]] && send "$2" ;;
    sample) sample ;;
    *) die "unknown action: $1" ;;
esac
