# Copy to ~/.config/ai/env, uncomment only what you use, then chmod 600.
# This is sourced as shell code by ~/.zshenv; never commit the real file.

# OpenCode subscriptions and Zen
# export OPENCODE_GO_API_KEY=""
# export OPENCODE_API_KEY=""

# Z.AI / GLM Coding Plan
# export ZAI_API_KEY=""

# Alibaba Cloud Model Studio / DashScope
# export DASHSCOPE_API_KEY=""

# Direct provider APIs (subscriptions usually do not include these APIs)
# export OPENAI_API_KEY=""
# export ANTHROPIC_API_KEY=""
# export GEMINI_API_KEY=""
# export OPENROUTER_API_KEY=""

# Optional Minuet overrides
# export MINUET_PROVIDER="openai_compatible"
# export MINUET_MODEL="deepseek-v4-flash"
# export MINUET_ENDPOINT="https://opencode.ai/zen/go/v1/chat/completions"
