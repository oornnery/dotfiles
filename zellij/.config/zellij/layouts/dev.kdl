// A project: files and editor, git, and a shell. Opened by the dev shell function.
layout {
    default_tab_template {
        pane size=1 borderless=true { plugin location="tab-bar"; }
        children
        pane size=1 borderless=true { plugin location="status-bar"; }
    }
    tab name="\u{f121} code" focus=true {
        pane split_direction="vertical" {
            // cd . because yazi believes $PWD, and Zellij hands down an old one
            pane size="25%" name="yazi" command="sh" {
                args "-c" "cd . && exec yazi"
            }
            pane focus=true command="helix"
        }
    }
    tab name="\u{e0a0} git" {
        pane command="lazygit"
    }
    tab name="\u{f120} shell" {
        pane
    }
}
