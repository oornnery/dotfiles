// Zellij with its own keys and modes. Only these additions: help, a palette with tv,
// yazi and lazygit on top, going straight to a tab, and bars with a color per item.
// The theme is written by dots theme, from the same palette as everything else.
theme "dots"
simplified_ui true
show_startup_tips false
show_release_notes false

// Both bars are zjstatus, a plugin that `dots install zellij` downloads. Its first start
// asks for permission: press y. Layouts ask for these two names, so they all get them.
// Colors are terminal colors, so they follow dots theme. Zjstatus cannot read the keys
// of a mode, so they are written here; every tab shares one style, and a click only
// switches tab.
plugins {
    tab-bar location="file:~/.local/share/zellij/plugins/zjstatus.wasm" {
        format_left "#[fg=green,bold] {session}  {tabs}"
        tab_normal "#[fg=black,bg=blue] {index} {name} {floating_indicator}#[fg=default,bg=default] "
        tab_active "#[fg=black,bg=green,bold] {index} {name} {floating_indicator}#[fg=default,bg=default] "
        tab_floating_indicator "\u{f2d0} "
    }
    status-bar location="file:~/.local/share/zellij/plugins/zjstatus.wasm" {
        format_left "{mode}"
        format_right "#[fg=yellow,bold]Alt #[fg=cyan]/ search  #[fg=green]? help  #[fg=blue]e files  #[fg=magenta]g git  #[fg=red]u tui "

        mode_normal "#[fg=default,bg=default,bold] Ctrl #[fg=black,bg=red] <g> LOCK #[fg=black,bg=green] <p> PANE #[fg=black,bg=yellow] <t> TAB #[fg=black,bg=blue] <n> RESIZE #[fg=black,bg=magenta] <h> MOVE #[fg=black,bg=cyan] <s> SEARCH #[fg=black,bg=white] <o> SESSION #[fg=black,bg=red] <q> QUIT "
        mode_locked "#[fg=black,bg=red,bold] LOCKED #[fg=black,bg=white] <Ctrl g> UNLOCK "
        mode_pane "#[fg=black,bg=green,bold] PANE #[fg=black,bg=yellow] <n> NEW #[fg=black,bg=red] <x> CLOSE #[fg=black,bg=blue] <f> FULL #[fg=black,bg=magenta] <w> FLOAT #[fg=black,bg=cyan] <e> EMBED #[fg=black,bg=white] <c> RENAME #[fg=black,bg=yellow] <s> STACK #[fg=black,bg=blue] <z> FRAMES "
        mode_tab "#[fg=black,bg=yellow,bold] TAB #[fg=black,bg=green] <n> NEW #[fg=black,bg=red] <x> CLOSE #[fg=black,bg=blue] <r> RENAME #[fg=black,bg=magenta] <h l> MOVE #[fg=black,bg=cyan] <1-9> GO #[fg=black,bg=white] <s> SYNC #[fg=black,bg=green] <b> BREAK "
        mode_resize "#[fg=black,bg=blue,bold] RESIZE #[fg=black,bg=green] <h j k l> GROW #[fg=black,bg=red] <H J K L> SHRINK #[fg=black,bg=yellow] <+ -> ALL "
        mode_move "#[fg=black,bg=magenta,bold] MOVE #[fg=black,bg=green] <h j k l> MOVE #[fg=black,bg=cyan] <n> NEXT #[fg=black,bg=yellow] <p> BACK "
        mode_scroll "#[fg=black,bg=cyan,bold] SCROLL #[fg=black,bg=green] <j k> LINE #[fg=black,bg=yellow] <d u> HALF #[fg=black,bg=blue] <s> SEARCH #[fg=black,bg=magenta] <e> EDIT #[fg=black,bg=white] <[ ]> PROMPT "
        mode_enter_search "#[fg=black,bg=cyan,bold] SEARCH #[fg=black,bg=white] TYPE, THEN <Enter> "
        mode_search "#[fg=black,bg=cyan,bold] SEARCH #[fg=black,bg=green] <n> NEXT #[fg=black,bg=yellow] <p> BACK #[fg=black,bg=blue] <c> CASE #[fg=black,bg=magenta] <w> WRAP #[fg=black,bg=white] <o> WORD "
        mode_session "#[fg=black,bg=white,bold] SESSION #[fg=black,bg=red] <d> DETACH #[fg=black,bg=green] <w> SESSIONS #[fg=black,bg=yellow] <c> CONFIG #[fg=black,bg=blue] <p> PLUGINS #[fg=black,bg=magenta] <a> ABOUT "
        mode_rename_tab "#[fg=black,bg=yellow,bold] RENAME TAB #[fg=black,bg=white] <Enter> DONE "
        mode_rename_pane "#[fg=black,bg=green,bold] RENAME PANE #[fg=black,bg=white] <Enter> DONE "
    }
}

keybinds {
    shared_except "locked" {
        bind "Alt /" {
            Run "dots" "palette" { floating true; close_on_exit true; }
        }
        // Some terminals report ? as Shift /, and then only the second name matches.
        bind "Alt ?" "Alt Shift /" {
            Run "dots" "palette" "help" { floating true; close_on_exit true; }
        }
        bind "Alt u" {
            Run "dots" "palette" "tui" { floating true; close_on_exit true; }
        }
        // Outside Zellij the shell has these two as well (conf.d/45-keys).
        // Zellij hands down an old $PWD and yazi believes it; cd . sets it right.
        bind "Alt e" {
            Run "sh" "-c" "cd . && exec yazi" { floating true; close_on_exit true; name "yazi"; }
        }
        bind "Alt g" {
            Run "lazygit" { floating true; close_on_exit true; }
        }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
    }
}
