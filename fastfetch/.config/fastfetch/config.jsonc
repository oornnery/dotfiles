// Terminal colors, so it follows dots theme. Only what makes sense on WSL.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": { "type": "auto", "padding": { "right": 3 } },
  "display": {
    "separator": " ",
    "color": { "keys": "magenta", "title": "magenta", "output": "default", "separator": "default" },
    "key": { "width": 15 },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": ["num-color", "bar"], "ndigits": 0 },
    "bar": {
      "width": 10,
      "char": { "elapsed": "■", "total": "·" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "cyan", "total": "default" }
    }
  },
  "modules": [
    "title",
    { "type": "os", "key": "  os" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "uptime", "key": "  uptime" },
    { "type": "packages", "key": "󰏖  packages" },
    { "type": "shell", "key": "  shell" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "cpu", "key": "  cpu", "showPeCoreCount": false },
    { "type": "gpu", "key": "  gpu" },
    { "type": "memory", "key": "  memory" },
    { "type": "swap", "key": "  swap" },
    { "type": "disk", "key": "  disk {1}", "folders": "/:/mnt/c" },
    { "type": "localip", "key": "󰩟  ip", "showIpv4": true, "showIpv6": false },
    { "type": "command", "key": "  theme", "text": "echo ${DOTS_THEME:-none}" },
    { "type": "command", "key": "  docker", "text": "n=$(docker ps -q 2>/dev/null | wc -l); [ \"$n\" = 0 ] || echo \"$n running\"" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
