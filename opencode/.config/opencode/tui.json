    "session_child_first": "<leader>down,ctrl+alt+j",
    "session_child_cycle": "ctrl+alt+l",
    "session_child_cycle_reverse": "ctrl+alt+h",
    "session_parent": "ctrl+alt+k",
    "agent_list": "<leader>a",
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab"
  },
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.14",
    [
      "oc-plugin-gitgud@0.1.8",
      {
        "replace_sidebar_files": true
      }
    ],
    "opencode-statusline@2.0.4",
    "opencode-worktree-manager@0.1.7",
    "opencode-project-panel@0.1.4",
    "opencode-subagent-statusline@1.2.1"
  ]
}
