{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@tarquinen/opencode-dcp@3.1.14",
    "@mohak34/opencode-notifier@0.2.8",
    "opencode-scheduler@1.3.0",
    "opencode-worktree-manager@0.1.7",
    "./plugins/caveman/plugin.js",
    "cc-safety-net@1.0.6",
    "openrtk@0.1.0",
    "./plugins/ponytail.js",
    "@bybrawe/opencode-loop@0.5.19",
    "opencode-update-notifier@0.3.3"
  ],
  "model": "openai/gpt-5.6-sol",
  "small_model": "opencode-go/gpt-5.6-luna",
  "agent": {
    "verifier": { "model": "opencode-go/qwen3.7-max" }
  },
  "command": {
    "web": {
      "description": "OpenCode web UI — localhost only. Set OPENCODE_SERVER_PASSWORD first for auth",
      "type": "local",
      "command": "opencode web --port 4096 --hostname 127.0.0.1"
    }
  },
  "instructions": [
    "instructions/opencode.md",
    "instructions/engineering.md"
  ],
  "references": {
    "opencode-setup": {
      "path": "~/.config/opencode/README.md",
      "description": "This machine's OpenCode setup documentation: installed plugins, CLI commands, troubleshooting"
    },
    "opencode-cheatsheet": {
      "path": "~/.config/opencode/cheatsheet.md",
      "description": "OpenCode cheatsheet: TUI shortcuts, keybinds, CLI flags, config"
    }
  },
  "mcp": {
    "cavemem": {
      "type": "local",
      "command": ["fnm", "exec", "--using=22", "--", "cavemem", "mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.78"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "rtk *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "pwd": "allow",
      "cd": "allow",
      "cd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "rg": "allow",
      "fd": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "find": "allow",
      "find *": "allow",
      "jq": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "test": "allow",
      "test *": "allow",
      "true": "allow",
      "false": "allow",
      "echo": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "print *": "allow",
      "xargs": "allow",
      "xargs *": "allow",
      "command -v *": "allow",
      "type *": "allow",
      "which *": "allow",
      "mktemp *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "ln -s *": "allow",
      "chmod +x *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "readlink *": "allow",
      "sha256sum *": "allow",
      "b2sum *": "allow",
      "md5sum *": "allow",
      "tar -t*": "allow",
      "unzip -l *": "allow",
      "zipinfo *": "allow",
      "column *": "allow",
      "seq *": "allow",
      "sleep *": "allow",
      "id": "allow",
      "id *": "allow",
      "whoami": "allow",
      "groups": "allow",
      "groups *": "allow",
      "locale": "allow",
      "locale *": "allow",
      "getconf *": "allow",
      "nproc": "allow",
      "nproc *": "allow",
      "bash -n *": "allow",
      "sh -n *": "allow",
      "zsh -n *": "allow",
      "ss -ltnp*": "allow",
      "ss -lnpt*": "allow",
      "ss -lupn*": "allow",
      "ss -lunp*": "allow",
      "ss -tulpn*": "allow",
      "ps": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "free": "allow",
      "free *": "allow",
      "df": "allow",
      "df *": "allow",
      "du": "allow",
      "du *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "date": "allow",
      "date *": "allow",
      "timeout *": "allow",
      "ip *": "allow",
      "fuser *": "allow",
      "fnm *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "ty *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "pnpx *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "cargo *": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "go *": "allow",
      "make": "allow",
      "make *": "allow",
      "cmake *": "allow",
      "ninja": "allow",
      "ninja *": "allow",
      "pytest": "allow",
      "shellcheck *": "allow",
      "shfmt *": "allow",
      "opencode *": "allow",
      "stow *": "allow",
      "gh auth token*": "ask",
      "rtk gh auth token*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "rtk git reset --hard*": "ask",
      "rtk git clean *": "ask",
      "rtk git restore *": "ask",
      "rtk git checkout -- *": "ask"
    },
    "schedule_job": "ask",
    "update_job": "ask",
    "delete_job": "ask",
    "run_job": "ask",
    "cleanup_global": "ask",
    "install_skill": "ask",
    "worktree_create": "ask",
    "worktree_switch": "ask",
    "worktree_finish": "ask"
  }

}
