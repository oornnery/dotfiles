{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@tarquinen/opencode-dcp@latest",
    "oh-my-opencode-slim",
    "opencode-with-claude"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "mcp": {
    "cavemem": {
      "type": "local",
      "command": [
        "/home/debian/.fnm/node-versions/v22.23.0/installation/bin/node",
        "/home/debian/.npm-global/lib/node_modules/cavemem/dist/index.js",
        "mcp"
      ],
      "enabled": true
    }
  },
  "lsp": true
}
